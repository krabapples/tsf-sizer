# Copy to .env next to docker-compose.yml and fill in. Never commit the real .env.

# Optional login for the web UI (HTTP basic auth). Set both.
#TSF_SIZER_USER=sizer
#TSF_SIZER_PASSWORD=choose-a-password

# The agent: off | gateway | direct (direct is for development with an OpenAI-compatible server)
TSF_SIZER_LLM_MODE=off

# --- Prisma AIRS AI Gateway (TSF_SIZER_LLM_MODE=gateway) -----------------------------------
# Base URL including the version path, the key issued for this application, and the model name
# exactly as the gateway exposes it.
#TSF_SIZER_GATEWAY_URL=https://gateway.example.com/v1
#TSF_SIZER_GATEWAY_API_KEY=
#TSF_SIZER_GATEWAY_MODEL=

# Only if your gateway needs them:
#TSF_SIZER_GATEWAY_AUTH_HEADER=Authorization      # e.g. x-api-key
#TSF_SIZER_GATEWAY_AUTH_SCHEME=Bearer              # empty = send the key as is
#TSF_SIZER_GATEWAY_HEADERS={"x-profile": "sizing"} # extra headers, e.g. a routing configuration
#TSF_SIZER_GATEWAY_CHAT_PATH=/chat/completions
#TSF_SIZER_GATEWAY_CA_BUNDLE=/certs/ca.pem         # mount the file into the container
#TSF_SIZER_GATEWAY_VERIFY_TLS=true
#TSF_SIZER_GATEWAY_TIMEOUT_S=120
#TSF_SIZER_GATEWAY_MAX_RETRIES=2
#TSF_SIZER_GATEWAY_TOOL_MODE=auto                  # native | json | auto
#TSF_SIZER_AGENT_MAX_STEPS=40

# --- Development: a plain OpenAI-compatible server (TSF_SIZER_LLM_MODE=direct) ---------------
#TSF_SIZER_DIRECT_URL=http://host.docker.internal:11434/v1
#TSF_SIZER_DIRECT_MODEL=qwen2.5:14b
#TSF_SIZER_DIRECT_API_KEY=
